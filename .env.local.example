# 환경 변수 예제
# 복사 후 .env.local 파일로 저장하여 사용하세요

# 사이트 URL (배포 후)
NEXT_PUBLIC_SITE_URL=https://trustrowan.kr

# 분석 (선택사항)
# NEXT_PUBLIC_GA_ID=

# 이미지 호스팅 (선택사항)
# NEXT_PUBLIC_IMAGE_DOMAIN=

# 카카오 지도 JavaScript API Key
# https://developers.kakao.com → 내 애플리케이션 → 앱 추가 → JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=141f8197b786b59fbab40e2c37277f20

# 카카오 공유 JavaScript 키 (지도 키와 다름)
# https://developers.kakao.com → 내 애플리케이션 → 앱 선택 → 앱 키 → JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=141f8197b786b59fbab40e2c37277f20
